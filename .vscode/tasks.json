{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "DrawApp: build",
            "type": "process",
            "command": "make",
            "args": ["draw"],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "DrawApp: animate",
            "type": "process",
            "command": "bash",
            "args": ["./run.sh"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "DrawApp: large maze",
            "type": "process",
            "command": "bash",
            "args": ["./run.sh", "--generate", "35", "35", "--seed", "42", "--solver", "wall", "--delay", "20"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "Maze: preview",
            "type": "process",
            "command": "make",
            "args": ["run", "ARGS=--preview"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        }
    ]
}
